---
import '../styles/global.css';

const tiers = [
  { badge: 'sprout', label: 'Foundation', name: 'A+ Educators', description: 'Build confidence and move from beginner to mastering tech — open to every educator, no cost, ever.', price: '$0', note: 'free, forever', features: ['Monthly webinar', 'Newsletter and resource library', 'Fire Chat community sessions', '50+ tech-integration videos'], cta: 'Join for free', href: 'https://forms.gle/AY1BGNLomEgssYhd6' },
  { badge: 'sapling', label: 'Momentum', name: 'Scalers', description: 'Build momentum with expert-led series, hands-on challenges, and accountability.', price: 'Coming soon', note: '', features: ['Everything in A+ Educators', 'Digiteach expert series', 'Tech challenges and certifications', 'Q&A Coffee Room'], cta: 'Get notified', href: 'https://forms.gle/AY1BGNLomEgssYhd6' },
  { badge: 'tree', label: 'Transformation', name: 'Thrivers', description: 'Build your brand, make money, and impact the world with focused 1-on-1 support.', price: '$30', note: '$50 regular rate', features: ['Everything in Scalers', 'LinkedIn Branding Masterclasses', 'Digital portfolio and Action Map', 'Monthly strategy session', 'Access to Canva Team'], cta: 'Claim a founding spot', href: 'https://flutterwave.com/pay/profitableeducatorsnexus', featured: true },
];
const quotes = [
  ['Byoung Freedom', 'I discovered Canva for Education and designed flyers to welcome students, introduce lessons, and turn ideas into infographics.', 'Rev Up Cohort 1.0'],
  ['Ammy Gracious', 'Even me wey be JJC for Canva don dey do small design. Thanks to La Prof — it’s worth the investment.', 'Rev Up Cohort 1.0'],
  ['Nkiruka Ojutalayo', 'The Level-Up Program helped me grow in confidence, creativity, and purpose — a great space to connect, learn, and level up.', 'Level Up Coaching Program'],
];
const faqs = [
  ['What is the difference between A+ Educators, Scalers, and Thrivers?', 'A+ Educators is our free, permanent community. Scalers and Thrivers are paid upgrade tiers adding expert-led training, accountability, and, for Thrivers, 1-on-1 support and brand-building resources.'],
  ['How do I join A+ Educators for free?', 'Click any Join A+ Educators button. It takes you to a short Google Form, after which you will be added to the community.'],
  ['What happens after I pay for Thrivers?', 'After your $10 deposit, you will receive confirmation and next steps by email. Once the balance is paid, you will receive your welcome pack and first session details.'],
  ['Is $30 a one-time payment?', 'Thrivers membership runs in 3-month cycles. $30 is the founding-member rate for your first quarter; the regular rate is $50 per quarter afterward.'],
];
---

<head>
  <link rel="icon" type="image/png" href="/assets/brand/logo.png" />
  <meta name="theme-color" content="#b9e4fa" />
</head>

<header class="sticky top-0 z-30 border-b border-transparent bg-parchment/85 backdrop-blur-xl">
  <nav class="mx-auto flex min-h-18 w-[min(calc(100%-2rem),1200px)] items-center justify-between gap-6" aria-label="Main navigation">
    <a class="flex shrink-0 items-center gap-2.5 font-sans text-[15px] font-semibold leading-none tracking-[-.025em] sm:text-lg" href="/"><img class="size-10 object-contain sm:size-11" src="/assets/brand/logo.png" alt="" /><span class="whitespace-nowrap">Profitable Educators <span class="text-violet">Nexus</span></span></a>
    <div class="hidden items-center gap-8 text-sm font-medium tracking-[-.01em] text-stone md:flex"><a href="#tiers">Programs</a><a href="#stories">Educator stories</a><a href="#faq">FAQs</a></div>
    <div class="flex items-center gap-3"><a class="hidden text-sm font-medium sm:block" href="mailto:profitableeducatorsnexus@gmail.com">Contact us</a><a class="btn btn-lilac" href="https://flutterwave.com/pay/profitableeducatorsnexus" target="_blank" rel="noopener">Join Thrivers ↗</a></div>
  </nav>
</header>

<div class="founding-float">
  <button class="founding-timer" id="founding-timer" type="button" aria-haspopup="dialog" aria-controls="founding-dialog">
    <span class="founding-dot" aria-hidden="true">✦</span>
    <span><span class="founding-label">Founding Thriver spots</span><strong class="founding-count" id="founding-count" aria-live="polite">Loading countdown…</strong></span>
    <span class="founding-hint">Details ↗</span>
  </button>
  <span id="shooting-stars" aria-hidden="true"></span>
</div>

<dialog class="founding-dialog" id="founding-dialog" aria-labelledby="founding-dialog-title">
  <div class="founding-dialog-content pt-24">
    <img class="founding-dialog-logo" src="/assets/brand/logo.png" alt="" />
    <button class="founding-dialog-close" id="founding-dialog-close" type="button" aria-label="Close founding Thriver details">×</button>
    <p class="eyebrow">Founding member offer</p>
    <h2 class="display mt-3 pr-8 text-4xl" id="founding-dialog-title">Build your next chapter with Thrivers.</h2>
    <p class="mt-4 text-stone">Save your spot with a $10 initial investment. The remaining $20 is due by September 30th. After that, Thrivers opens to everyone at $50.</p>
    <a class="btn btn-wine mt-6" href="https://flutterwave.com/pay/profitableeducatorsnexus" target="_blank" rel="noopener">Secure your founding spot ↗</a>
  </div>
</dialog>

<main>
  <section class="hero-grid screen-section relative isolate min-h-[680px] overflow-hidden text-ink">
    <div class="mx-auto flex min-h-[680px] w-[min(calc(100%-2rem),1200px)] items-center py-24">
      <div class="reveal max-w-3xl"><p class="eyebrow text-violet">Build, excel &amp; thrive with technology</p><h1 class="display mt-6 text-[3.5rem] sm:text-8xl lg:text-[7.25rem]">Make technology work for your classroom, career, and next chapter.</h1><p class="mt-7 max-w-xl text-lg text-ink/75">Profitable Educators Nexus helps educators <strong class="font-medium text-ink">build confidence, grow their professional brand, and create new income opportunities</strong> with technology.</p><div class="mt-9 flex flex-wrap gap-3"><a class="btn btn-wine" href="https://forms.gle/AY1BGNLomEgssYhd6" target="_blank" rel="noopener">Join A+ Educators — free ↗</a><a class="btn btn-outline-dark" href="#tiers">Explore the pathways ↓</a></div><p class="mt-5 text-sm text-ink/60">A growth community and membership pathway from A+ Educators.</p></div>
    </div>
    <aside class="glass-card absolute bottom-8 right-4 hidden w-60 rotate-3 md:block lg:right-[8%]"><small class="font-bold uppercase tracking-wider text-violet">Community highlight</small><p class="mt-2 text-sm leading-snug">More than 1,500 educators are building their next chapter with technology.</p></aside>
  </section>

  <section class="border-b border-mist bg-cloud"><div class="mx-auto grid w-[min(calc(100%-2rem),1200px)] grid-cols-1 sm:grid-cols-3"><div class="border-b border-mist px-6 py-7 sm:border-b-0 sm:border-r"><strong class="text-3xl font-medium tracking-tight text-wine">1,500+</strong><p class="text-sm text-stone">educators in the community</p></div><div class="border-b border-mist px-6 py-7 sm:border-b-0 sm:border-r"><strong class="text-3xl font-medium tracking-tight text-wine">10+</strong><p class="text-sm text-stone">countries across 3 continents</p></div><div class="px-6 py-7"><strong class="text-3xl font-medium tracking-tight text-wine">50+</strong><p class="text-sm text-stone">tech-integration videos</p></div></div></section>

  <section class="screen-section mx-auto w-[min(calc(100%-2rem),1200px)] py-16 lg:py-20"><div class="section-glass grid w-full grid-cols-1 gap-8 lg:grid-cols-[.8fr_1.2fr]"><p class="eyebrow">The promise</p><div><h2 class="display text-5xl sm:text-6xl">In three months, you can feel more confident, capable, and at home with technology.</h2><div class="mt-7 max-w-lg space-y-4 text-lg text-stone"><p>Start wherever you are. Learn what you need. Build the confidence to make technology serve your classroom, your career, and your wider purpose.</p><p>Every pathway moves you toward becoming an educator who builds, excels, and thrives with tech.</p></div></div></div></section>

<section class="screen-section bg-sky py-16 lg:py-20" id="tiers"><div class="section-glass mx-auto w-[min(calc(100%-2rem),1200px)]"><div class="mb-10 flex flex-col justify-between gap-5 md:flex-row md:items-end"><div><p class="eyebrow">Choose your pathway</p><h2 class="display mt-3 max-w-2xl text-5xl sm:text-6xl">Start free. Choose your next level.</h2></div><p class="max-w-xs text-stone">Find the level of support that matches your goals and your season of growth.</p></div><div class="grid gap-4 lg:grid-cols-3">{tiers.map((tier) => <article class:list={["glass-panel flex min-h-[360px] flex-col p-6", { 'border-violet/40': tier.featured }]}><img class="mb-6 size-12" src={`/assets/brand/tier-${tier.badge === 'sprout' ? 'foundation' : tier.badge === 'sapling' ? 'momentum' : 'transformation'}.svg`} alt={`${tier.label} icon`} /><p class:list={["eyebrow", { 'text-violet': tier.featured }]}>{tier.label}</p><h3 class="mt-3 text-3xl font-semibold tracking-tight">{tier.name}</h3><p class="mt-3 min-h-18 text-ink/80">{tier.description}</p><div class="my-5 text-2xl font-medium">{tier.price} {tier.note && <small class="text-sm font-normal text-stone">{tier.note}</small>}</div><ul class="mb-5 grid gap-2 text-sm text-ink/75">{tier.features.map((feature) => <li>↗ {feature}</li>)}</ul><a class="btn btn-lilac mt-auto self-start" href={tier.href} target="_blank" rel="noopener">{tier.cta} ↗</a></article>)}</div></div></section>

  <section class="screen-section mx-auto w-[min(calc(100%-2rem),1200px)] py-16 lg:py-20" id="stories"><div class="section-glass w-full"><div class="grid items-center gap-8 lg:grid-cols-[.8fr_1.2fr]"><div><p class="eyebrow">Real educators, real results</p><h2 class="display mt-4 text-5xl sm:text-6xl">See what becomes possible when educators learn together.</h2><p class="mt-6 text-lg text-stone">Take a look inside one of our practical, community-led learning sessions.</p></div><div class="glass-panel p-3"><video class="w-full rounded-xl" controls preload="none" poster="/assets/media/poster.jpg"><source src="/assets/media/canva-training.mp4" type="video/mp4" /></video><p class="px-2 pb-1 pt-3 text-sm text-stone">Canva for Educators — a look inside one of our live training sessions.</p></div></div><div class="mt-8 grid gap-4 md:grid-cols-3">{quotes.map(([author, quote, tag]) => <article class="glass-panel p-5"><div class="text-5xl leading-none text-violet">“</div><p class="my-4 text-sm">{quote}</p><strong class="text-sm">{author}</strong><span class="mt-1 block text-[11px] uppercase tracking-wider text-violet">{tag}</span></article>)}</div></div></section>

  <section class="screen-section relative overflow-hidden bg-lilac py-16 text-ink lg:py-20"><div class="section-glass relative z-10 mx-auto grid w-[min(calc(100%-2rem),1200px)] gap-8 lg:grid-cols-2 lg:items-center"><div><p class="eyebrow">The nexus effect</p><h2 class="display mt-4 max-w-xl text-5xl sm:text-6xl">Your next opportunity may be closer than you think.</h2></div><div><p class="max-w-lg text-lg text-ink/70">Technology is more than a classroom tool. It can make your expertise visible, valuable, and easier to share.</p><a class="btn btn-outline-dark mt-7" href="#tiers">Find your pathway ↓</a></div></div></section>
  <section class="screen-section atmosphere py-16 lg:py-20"><div class="section-glass mx-auto flex w-[min(calc(100%-2rem),1200px)] flex-col justify-between gap-8 md:flex-row md:items-center"><div><p class="eyebrow">Your next step</p><h2 class="display mt-4 max-w-3xl text-5xl sm:text-6xl">Make space for work that can grow.</h2><p class="mt-5 max-w-sm text-stone">Turn curiosity into capability, then turn capability into meaningful momentum.</p></div><a class="btn btn-wine shrink-0" href="https://flutterwave.com/pay/profitableeducatorsnexus" target="_blank" rel="noopener">Join the Thrivers ↗</a></div></section>

  <section class="screen-section bg-wine py-16 text-center text-white lg:py-20"><div class="mx-auto w-[min(calc(100%-2rem),1200px)]"><div class="glass-dark p-8 sm:p-12"><h2 class="display mx-auto max-w-3xl text-5xl sm:text-6xl">15 founding spots remain for Thrivers.</h2><p class="mx-auto mt-5 max-w-xl text-white/70">Secure your place with a $10 deposit, then pay the remaining $20 by September 30th.</p><div class="mt-8 flex flex-wrap justify-center gap-3"><a class="btn btn-lilac" href="https://flutterwave.com/pay/profitableeducatorsnexus" target="_blank" rel="noopener">Secure a founding spot ↗</a><a class="btn btn-outline" href="https://forms.gle/AY1BGNLomEgssYhd6" target="_blank" rel="noopener">Join A+ Educators ↗</a></div></div></div></section>

  <section class="screen-section mx-auto w-[min(calc(100%-2rem),800px)] py-16 lg:py-20" id="faq"><div class="section-glass w-full"><div class="mb-10 text-center"><p class="eyebrow">Got questions?</p><h2 class="display mt-3 text-5xl sm:text-6xl">Frequently asked questions</h2></div>{faqs.map(([question, answer]) => <details class="border-t border-mist py-4 last:border-b"><summary class="cursor-pointer pr-8 text-lg font-medium marker:hidden">{question}</summary><p class="mt-3 max-w-2xl text-stone">{answer}</p></details>)}</div></section>
</main>

<footer class="bg-wine py-16 text-white"><div class="mx-auto grid w-[min(calc(100%-2rem),1200px)] gap-10 border-b border-white/15 pb-14 md:grid-cols-[1.5fr_1fr_1fr]"><div><div class="flex items-center gap-2.5 font-sans text-xl font-semibold tracking-[-.025em]"><img class="size-10 object-contain" src="/assets/brand/logo.png" alt="" /><span>Profitable Educators <span class="text-violet">Nexus</span></span></div><p class="mt-3 max-w-xs text-sm text-white/60">A program of A+ Educators — build, excel, and thrive with technology.</p></div><div><h2 class="mb-3 text-xs font-bold uppercase tracking-wider text-lilac">Community</h2><a class="block py-1 text-sm text-white/70" href="#tiers">A+ Educators — free</a><a class="block py-1 text-sm text-white/70" href="#tiers">Scalers</a><a class="block py-1 text-sm text-white/70" href="#tiers">Thrivers</a></div><div><h2 class="mb-3 text-xs font-bold uppercase tracking-wider text-lilac">Connect</h2><a class="block py-1 text-sm text-white/70" href="#faq">Frequently asked questions</a><a class="block py-1 text-sm text-white/70" href="mailto:profitableeducatorsnexus@gmail.com">Contact us</a></div></div><p class="mx-auto mt-6 w-[min(calc(100%-2rem),1200px)] text-xs text-white/45">© 2026 Profitable Educators Nexus, a program of A+ Educators. Operated by Sparkles Educonsult.</p></footer>

<script>
  import { gsap } from 'gsap';
  import { ScrollTrigger } from 'gsap/ScrollTrigger';
  gsap.registerPlugin(ScrollTrigger);
  gsap.utils.toArray<HTMLElement>('.reveal').forEach((element) => gsap.to(element, { opacity: 1, y: 0, duration: .9, ease: 'power3.out', scrollTrigger: { trigger: element, start: 'top 85%', once: true } }));

  const deadline = new Date('2026-09-12T23:59:59').getTime();
  const countdown = document.getElementById('founding-count');
  const timerButton = document.getElementById('founding-timer') as HTMLButtonElement | null;
  const dialog = document.getElementById('founding-dialog') as HTMLDialogElement | null;
  const closeDialog = document.getElementById('founding-dialog-close') as HTMLButtonElement | null;

  const updateCountdown = () => {
    if (!countdown) return;
    const remaining = deadline - Date.now();
    if (remaining <= 0) { countdown.textContent = 'Founding offer closed'; return; }
    const days = Math.floor(remaining / 86400000);
    const hours = Math.floor((remaining % 86400000) / 3600000);
    const minutes = Math.floor((remaining % 3600000) / 60000);
    countdown.textContent = `${days}d ${hours}h ${minutes}m remaining`;
  };

  updateCountdown();
  window.setInterval(updateCountdown, 60000);
  timerButton?.addEventListener('click', () => dialog?.showModal());
  closeDialog?.addEventListener('click', () => dialog?.close());
  dialog?.addEventListener('click', (event) => { if (event.target === dialog) dialog.close(); });

  const starField = document.getElementById('shooting-stars');
  const reducedMotion = window.matchMedia('(prefers-reduced-motion: reduce)').matches;
  const shootBurst = () => {
    if (!starField || reducedMotion) return;
    const trajectories = [[-105, -100], [0, -135], [105, -92]];
    trajectories.forEach(([x, y], index) => {
      const star = document.createElement('span');
      star.className = 'shooting-star';
      star.textContent = '✦';
      star.style.setProperty('--star-x', `${x + Math.round((Math.random() - .5) * 24)}px`);
      star.style.setProperty('--star-y', `${y + Math.round((Math.random() - .5) * 18)}px`);
      star.style.animationDelay = `${index * 100}ms`;
      starField.appendChild(star);
      window.setTimeout(() => star.remove(), 1700);
    });
  };
  window.setTimeout(shootBurst, 1600);
  window.setInterval(shootBurst, 5000);
</script>
